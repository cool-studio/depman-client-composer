{
    "name": "depman/client",
    "description": "Reports installed Composer dependencies to DepMan from a post-install hook.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Depman\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Depman\\Client\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/depman"
    ],
    "scripts": {
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --no-progress"
        ],
        "test": [
            "phpunit --testsuite client"
        ],
        "smoke": [
            "phpunit --testsuite smoke"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test",
            "@smoke"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}

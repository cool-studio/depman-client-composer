<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone by design. Nothing here names a path outside the package, so
    `git clone`, `composer install`, `composer check` is the whole story for a
    contributor who has never seen the DepMan application.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="client">
            <directory>tests</directory>
            <exclude>tests/Smoke</exclude>
        </testsuite>
        <!--
            Installs the dist archive into a scratch project and runs it
            (ADR-0055). Separate so `composer test` stays fast while editing;
            `composer check` runs both, and that is the gate.
        -->
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

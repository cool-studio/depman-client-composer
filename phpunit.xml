<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone by design. This config names no path outside the package and
    depends on nothing from the parent application, so `depman/client` can be
    cloned, tested and released on its own — which is the point of speccing the
    clients rather than letting each grow its own habits.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="client">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

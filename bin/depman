#!/usr/bin/env php
<?php

declare(strict_types=1);

use Depman\Client\Client;
use Depman\Client\Config;
use Depman\Client\Gate;
use Depman\Client\GateResult;
use Depman\Client\Logger;
use Depman\Client\Pusher;
use Depman\Client\Reporter;
use Depman\Client\Resolver;
use Depman\Client\Result;
use Depman\Client\ScriptHandler;
use Depman\Client\Token;

// Composer 2.2+ hands the bin proxy the autoloader path directly, which is the
// only reliable option when the package is installed from a symlinked path
// repository. The rest are fallbacks for older Composer and standalone use.
$candidates = array_filter([
    $_composer_autoload_path ?? null,
    __DIR__.'/../../../autoload.php',
    __DIR__.'/../vendor/autoload.php',
    getcwd().'/vendor/autoload.php',
]);

$loaded = false;

foreach ($candidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}

if (! $loaded) {
    fwrite(STDERR, "depman: could not locate the Composer autoloader.\n");
    exit(1);
}

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'help';
$root = ScriptHandler::projectRoot();

$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (str_starts_with($argument, '--')) {
        [$key, $value] = array_pad(explode('=', substr($argument, 2), 2), 2, '1');
        $options[$key] = $value;
    }
}

$logger = new Logger($options['log-level'] ?? getenv('DEPMAN_LOG_LEVEL') ?: 'info');

/**
 * `report --wait [--fail-on=<severity>]`, printed and turned into an exit code.
 *
 * Everything that decides anything is in Gate; this only formats. See
 * docs/ingest-clients.md §10.
 *
 * @param  array<string, string>  $options
 */
function depman_gate(string $root, Logger $logger, array $options, Result $result): int
{
    $threshold = isset($options['fail-on']) ? strtolower($options['fail-on']) : null;

    // Clamped rather than honoured, exactly as the request timeout is: an
    // absurd value here is a typo, and a gate that waits for an hour has
    // stopped being a gate and become a hung build.
    $timeout = max(10, min((int) ($options['wait-timeout'] ?? 300), 3600));

    $verdict = (new Gate($logger, new Reporter($logger)))->run($root, $result, $threshold, $timeout);

    $summary = $verdict->summary();

    if ($summary !== null) {
        printf("Open findings: %s.\n", $summary);
    }

    echo match ($verdict->status) {
        GateResult::PASSED => $threshold === null
            ? "Scan complete.\n"
            : sprintf("Gate passed: nothing at %s or above.\n", $threshold),
        GateResult::BREACHED => sprintf("Gate FAILED: %s.\n", $verdict->detail),
        default => sprintf("Gate could not decide: %s\n", $verdict->detail),
    };

    return $verdict->exitCode();
}

switch ($command) {
    case 'report':
        $client = new Client($logger, new Resolver($logger), new Reporter($logger));
        $result = $client->report($root, 'manual');

        echo match ($result->status) {
            'reported' => sprintf("Reported %d packages.%s\n", $result->packages,
                $result->deduplicated ? ' (unchanged since the last report)' : ''),
            'spooled' => sprintf("Could not reach DepMan (%s); spooled for later.\n", $result->detail),
            'failed' => sprintf("Report rejected: %s\n", $result->detail),
            default => sprintf("Skipped: %s\n", $result->detail),
        };

        // CI gating. --fail-on= implies --wait, because the findings a threshold
        // is compared against do not exist until the scan behind the report has
        // run. This is the only mode allowed to fail a build.
        if (isset($options['wait']) || isset($options['fail-on'])) {
            exit(depman_gate($root, $logger, $options, $result));
        }

        // Only an explicit --fail-on-error, or the config equivalent, makes a
        // failure exit non-zero. Everything else exits 0 by design.
        $failOnError = isset($options['fail-on-error'])
            || (Config::load($root, $logger)?->failOnError() ?? false);

        exit($result->isFailure() && $failOnError ? 1 : 0);

    case 'push':
        $push = (new Pusher($logger, new Reporter($logger)))->push($root);

        echo match ($push->status) {
            'drained' => $push->sent === 0 && $push->discarded === 0
                ? "Nothing spooled.\n"
                : sprintf("Pushed %d spooled report%s.%s\n", $push->sent, $push->sent === 1 ? '' : 's',
                    $push->discarded === 0 ? '' : sprintf(' Discarded %d that will never be accepted.', $push->discarded)),
            'stopped' => sprintf("Pushed %d spooled report%s; %d still queued (%s).\n",
                $push->sent, $push->sent === 1 ? '' : 's', $push->remaining, $push->detail),
            default => sprintf("Skipped: %s\n", $push->detail),
        };

        // Same contract as `report`: an undeliverable spool is what the spool is
        // for and exits 0. Only a rejection, and only when asked, is non-zero.
        $failOnError = isset($options['fail-on-error'])
            || (Config::load($root, $logger)?->failOnError() ?? false);

        exit($push->isFailure() && $failOnError ? 1 : 0);

    case 'doctor':
        $config = Config::load($root, $logger);

        if ($config === null) {
            echo "No depman.json found in {$root}.\n";
            exit(0);
        }

        $endpoint = $config->endpoint();
        $environment = $config->environment();
        $token = Token::locate($endpoint, [], $root);

        // The source on every line, not just the token's. A `.env` shadows a
        // process env var for every setting, so "which of these three won?" is
        // the question doctor exists to answer.
        printf("Project:      %s (from %s)\n", $config->project() ?? '(not set)', $config->sourceOf('project', 'DEPMAN_PROJECT'));
        printf("Endpoint:     %s (from %s)\n", $endpoint, $config->sourceOf('endpoint', 'DEPMAN_ENDPOINT'));
        printf("Environment:  %s (from %s)\n", $environment['name'], $environment['resolvedFrom']);
        // The source, not just "found". When the wrong mechanism wins, the
        // symptom is a 401 with no clue which of four places produced the
        // credential — and this line is the answer.
        printf("Token:        %s\n", $token === null
            ? 'not found — set DEPMAN_TOKEN in .env or the environment'
            : 'found via '.$token->source);
        printf("Include dev:  %s\n", $config->includeDev() ? 'yes' : 'no');
        exit(0);

    case 'install-hook':
        $path = rtrim($root, '/').'/composer.json';
        $decoded = json_decode((string) file_get_contents($path), true);

        if (! is_array($decoded)) {
            echo "Could not read composer.json.\n";
            exit(1);
        }

        foreach (['post-install-cmd', 'post-update-cmd'] as $hook) {
            $existing = (array) ($decoded['scripts'][$hook] ?? []);

            if (! in_array(ScriptHandler::class.'::report', $existing, true)) {
                $existing[] = ScriptHandler::class.'::report';
            }

            $decoded['scripts'][$hook] = $existing;
        }

        file_put_contents($path, json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)."\n");
        echo "Added the DepMan hook to post-install-cmd and post-update-cmd.\n";
        exit(0);

    default:
        echo <<<'TEXT'
        depman — report installed Composer dependencies to DepMan

          depman report [--fail-on-error]   Report the installed tree now
          depman push  [--fail-on-error]    Send everything left in the offline spool
          depman doctor                     Show the resolved configuration
          depman install-hook               Add the post-install hook to composer.json

        CI gating — the only mode that may fail a build. Put it in its own step,
        never in post-install-cmd:

          depman report --wait [--fail-on=<severity>] [--wait-timeout=<seconds>]

        Waits for DepMan to scan the report, then exits 1 if any open finding in
        that environment is at <severity> or worse, and 2 if it could not find
        out. <severity> is one of critical, high, medium, low, unknown; the wait
        defaults to 300 seconds.

        The token is read from DEPMAN_TOKEN, DEPMAN_TOKEN_FILE, or
        ~/.depman/credentials. It must never be placed in depman.json, which is
        committed to source control.

        TEXT;
        exit(0);
}
